<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RD-SMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            margin: 0;
            background: #f4f7fb;
            font-family: 'Segoe UI', sans-serif;
        }

        /*================ NAVBAR ================*/

        .navbar {
            background: linear-gradient(135deg, #0d6efd, #003c8f);
            box-shadow: 0 5px 15px rgba(0, 0, 0, .15);
            height: 70px;
            z-index: 1000;
        }

        .navbar-brand {
            font-size: 26px;
            font-weight: bold;
            color: white !important;
        }

        .navbar-brand i {
            color: #ffc107;
        }

        /*================ SIDEBAR ================*/

        .sidebar {

            position: fixed;
            top: 70px;
            left: 0;
            width: 250px;
            height: 100%;
            background: #1f2937;
            transition: .3s;
            overflow-y: auto;

        }

        .sidebar a {

            display: block;
            color: #d1d5db;
            text-decoration: none;
            padding: 15px 25px;
            transition: .3s;
            font-size: 16px;

        }

        .sidebar a:hover {

            background: #0d6efd;
            color: white;
            padding-left: 35px;

        }

        .sidebar i {

            margin-right: 10px;

        }

        /*================ CONTENT ================*/

        .main-content {

            margin-left: 250px;
            margin-top: 90px;
            padding: 30px;

        }

        /*================ SEARCH ================*/

        .search-box {

            border-radius: 30px;
            width: 250px;

        }

        .search-btn {

            border-radius: 30px;

        }

        /*================ PROFILE ================*/

        .profile {

            color: white;
            text-decoration: none;
            margin-left: 20px;

        }

        .profile:hover {

            color: #ffc107;

        }

        /*================ MOBILE ================*/

        @media(max-width:991px) {

            .sidebar {

                left: -250px;

            }

            .sidebar.active {

                left: 0;

            }

            .main-content {

                margin-left: 0;

            }

        }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">

        <div class="container-fluid">

            <button class="btn btn-outline-light me-3" id="menuBtn">
                <i class="bi bi-list"></i>
            </button>

            <a class="navbar-brand" href="/">
                <i class="bi bi-mortarboard-fill"></i>
                RD-SMS
            </a>

            <div class="ms-auto d-flex align-items-center">

                <form class="d-flex">

                    <input class="form-control search-box me-2" type="search" placeholder="Search">

                    <button class="btn btn-warning search-btn">

                        <i class="bi bi-search"></i>

                    </button>

                </form>

                <a href="#" class="profile">

                    <i class="bi bi-person-circle fs-4"></i>

                    Admin

                </a>

            </div>

        </div>

    </nav>

    <!-- Sidebar -->

    <div class="sidebar" id="sidebar">

        <a href="/">
            <i class="bi bi-speedometer2"></i>
            Dashboard
        </a>

        <a href="/">
            <i class="bi bi-person-plus-fill"></i>
            Add Student
        </a>

        <a href="/students">
            <i class="bi bi-people-fill"></i>
            Student List
        </a>

        <a href="/add/bookpage">
            <i class="bi bi-book-fill"></i>
            Add Book
        </a>

        <a href="/books">
            <i class="bi bi-journal-bookmark-fill"></i>
            Book List
        </a>

        <a href="/issue/books">
            <i class="bi bi-journal-check"></i>
            Issue Book
        </a>

        <a href="/returned/books">
            <i class="bi bi-arrow-return-left"></i>
            Return Book
        </a>

        <a href="#">
            <i class="bi bi-bar-chart-fill"></i>
            Reports
        </a>

        <a href="#">
            <i class="bi bi-gear-fill"></i>
            Settings
        </a>

        <a href="#">
            <i class="bi bi-box-arrow-right"></i>
            Logout
        </a>

    </div>

    <div class="main-content">